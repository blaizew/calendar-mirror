<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu-bar status app LaunchAgent. Placeholders: __BINARY__ __DIR__
     Rendered + loaded by install.sh. RunAtLoad + KeepAlive = starts at login, stays running. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.calendar-mirror.menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BINARY__</string>
        <string>__DIR__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__DIR__/menubar.out.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/menubar.err.log</string>
</dict>
</plist>
