<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent template. Placeholders: __PYTHON__ __DIR__ __INTERVAL__
     Run ./install.sh to render this (interval comes from config.json) and load it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.calendar-mirror</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__DIR__/mirror.py</string>
        <string>--apply</string>
    </array>

    <!-- launchd defaults cwd to / (not writable); give gws a writable working dir -->
    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <!-- Run interval in seconds (rendered from config.json's interval_seconds by install.sh) -->
    <key>StartInterval</key>
    <integer>__INTERVAL__</integer>

    <!-- Also run once at load -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__DIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/launchd.err.log</string>
</dict>
</plist>
